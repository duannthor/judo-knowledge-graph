---
const {
  pageType = "page",
  pageTitle = "Technical Machine",
  subjectSlug = "",
  subjectName = ""
} = Astro.props;

const feedbackFormEndpoint = import.meta.env.PUBLIC_CORRECTION_FORM_ENDPOINT ?? "https://splitforms.com/api/submit";
const feedbackFormAccessKey = import.meta.env.PUBLIC_SPLITFORMS_ACCESS_KEY ?? "";
const feedbackFormEnabled = Boolean(feedbackFormAccessKey);
const subjectLabel = subjectName || pageTitle;
---

<button class="correction-trigger" type="button" data-feedback-open aria-controls="feedback-dialog">
  <span class="correction-trigger-full">Submit feedback</span>
  <span class="correction-trigger-short">Feedback</span>
</button>

<dialog class="correction-dialog" id="feedback-dialog" aria-labelledby="feedback-title">
  <form
    class="correction-form"
    action={feedbackFormEndpoint}
    method="POST"
    data-feedback-form
    data-enabled={feedbackFormEnabled ? "true" : "false"}
  >
    <input type="hidden" name="access_key" value={feedbackFormAccessKey} />
    <input type="hidden" name="form_name" value="Technical Machine feedback" />
    <input type="hidden" name="page_type" value={pageType} />
    <input type="hidden" name="page_title" value={pageTitle} />
    <input type="hidden" name="subject_slug" value={subjectSlug} />
    <input type="hidden" name="subject_name" value={subjectName} />
    <input type="hidden" name="page_url" value="" data-feedback-page-url />
    <input type="hidden" name="_start_time" value="" data-feedback-start-time />
    <label class="sr-only" for="feedback-botcheck">Leave this unchecked</label>
    <input id="feedback-botcheck" type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" />

    <div class="correction-header">
      <div>
        <p class="eyebrow">Anonymous feedback</p>
        <h2 id="feedback-title">Submit feedback</h2>
        <p>
          Tell me what would make <b><u>{subjectLabel}</u></b> clearer or more useful. Sources are welcome, but optional.
        </p>
      </div>
      <button class="icon-button" type="button" data-feedback-close aria-label="Close feedback form">x</button>
    </div>

    {!feedbackFormEnabled && (
      <p class="correction-status warning">
        Add <code>PUBLIC_SPLITFORMS_ACCESS_KEY</code> to enable submissions.
      </p>
    )}

    <label for="feedback-area">
      <span>Type</span>
    </label>
    <select id="feedback-area" name="area">
      <option value="correction">Correction</option>
      <option value="enhancement-request">Enhancement request</option>
      <option value="name-translation">Name / translation</option>
      <option value="mechanics">Mechanics</option>
      <option value="safety-legality">Safety / legality</option>
      <option value="video">Video</option>
      <option value="promotion-requirement">Promotion requirement</option>
      <option value="combo-counter">Combo / counter</option>
      <option value="other">Other</option>
    </select>

    <label for="feedback-message">
      <span>Feedback</span>
    </label>
    <textarea id="feedback-message" name="message" rows="5" required placeholder="Example: I would like a comparison between the standard and drop versions here."></textarea>

    <label for="feedback-suggestion">
      <span>Suggested change</span>
    </label>
    <textarea id="feedback-suggestion" name="suggested_correction" rows="3" placeholder="What should change or be added?"></textarea>

    <label for="feedback-source-url">
      <span>Source link</span>
    </label>
    <input id="feedback-source-url" name="source_url" type="url" placeholder="https://..." />

    <label for="feedback-contact-email">
      <span>Email, optional</span>
    </label>
    <input id="feedback-contact-email" name="contact_email" type="email" placeholder="Only if you want a follow-up." />

    <p class="correction-status" data-feedback-status aria-live="polite"></p>

    <div class="correction-actions">
      <button class="clear-filters" type="button" data-feedback-close>Cancel</button>
      <button class="preset-chip" type="submit" disabled={!feedbackFormEnabled}>Send feedback</button>
    </div>
  </form>
</dialog>

<script is:inline>
  (() => {
    const feedbackDialog = document.querySelector("#feedback-dialog");
    const feedbackOpen = document.querySelector("[data-feedback-open]");
    const feedbackCloseButtons = Array.from(document.querySelectorAll("[data-feedback-close]"));
    const feedbackForm = document.querySelector("[data-feedback-form]");
    const feedbackStatus = document.querySelector("[data-feedback-status]");
    const feedbackPageUrl = document.querySelector("[data-feedback-page-url]");
    const feedbackStartTime = document.querySelector("[data-feedback-start-time]");

    if (feedbackPageUrl instanceof HTMLInputElement) {
      feedbackPageUrl.value = window.location.href;
    }
    if (feedbackStartTime instanceof HTMLInputElement) {
      feedbackStartTime.value = String(Date.now());
    }

    feedbackOpen?.addEventListener("click", () => {
      if (feedbackDialog instanceof HTMLDialogElement) feedbackDialog.showModal();
    });

    for (const button of feedbackCloseButtons) {
      button.addEventListener("click", () => {
        if (feedbackDialog instanceof HTMLDialogElement) feedbackDialog.close();
      });
    }

    feedbackDialog?.addEventListener("click", (event) => {
      if (event.target === feedbackDialog && feedbackDialog instanceof HTMLDialogElement) {
        feedbackDialog.close();
      }
    });

    feedbackForm?.addEventListener("submit", async (event) => {
      if (!(feedbackForm instanceof HTMLFormElement)) return;
      if (feedbackForm.dataset.enabled !== "true") {
        event.preventDefault();
        if (feedbackStatus instanceof HTMLElement) {
          feedbackStatus.textContent = "Feedback submissions need a Splitforms access key first.";
          feedbackStatus.className = "correction-status warning";
        }
        return;
      }

      event.preventDefault();
      if (feedbackStatus instanceof HTMLElement) {
        feedbackStatus.textContent = "Sending...";
        feedbackStatus.className = "correction-status";
      }

      try {
        const response = await fetch(feedbackForm.action, {
          method: feedbackForm.method,
          body: new FormData(feedbackForm),
          headers: { Accept: "application/json" }
        });

        if (!response.ok) throw new Error("Submission failed");
        feedbackForm.reset();
        if (feedbackStartTime instanceof HTMLInputElement) {
          feedbackStartTime.value = String(Date.now());
        }
        if (feedbackPageUrl instanceof HTMLInputElement) {
          feedbackPageUrl.value = window.location.href;
        }
        if (feedbackStatus instanceof HTMLElement) {
          feedbackStatus.textContent = "Thank you. I'll review this feedback.";
          feedbackStatus.className = "correction-status success";
        }
      } catch {
        if (feedbackStatus instanceof HTMLElement) {
          feedbackStatus.textContent = "Something went wrong. Please try again in a moment.";
          feedbackStatus.className = "correction-status warning";
        }
      }
    });
  })();
</script>
