---
import FeedbackForm from "../components/FeedbackForm.astro";
import "../styles/global.css";
import "../styles/technical-machine.css";

const {
  title = "Technical Machine",
  description = "A static-first judo technique browser.",
  feedbackPageType = "page",
  feedbackSubjectSlug = "",
  feedbackSubjectName = ""
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
const urlFor = (path) => `${baseUrl.replace(/\/?$/, "/")}${path.replace(/^\//, "")}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={urlFor("/technical-machine-icon.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Yuji+Boku&family=Yuji+Syuku&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <div class="technical-machine" data-technical-machine>
      <script is:inline>
        const technicalMachineRoot = document.currentScript.closest("[data-technical-machine]");
        const storedTheme = localStorage.getItem("judo-theme");
        if (storedTheme === "light" || storedTheme === "dark") {
          technicalMachineRoot.dataset.theme = storedTheme;
        } else {
          technicalMachineRoot.dataset.theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
      </script>
      <header class="site-header">
        <nav class="shell site-nav" aria-label="Primary">
          <a class="brand" href={urlFor("/")}>
            <img src={urlFor("/technical-machine-icon.svg")} alt="" width="36" height="36" />
            <span>Technical Machine</span>
          </a>
          <div class="nav-links">
            <a href="/">Main site</a>
            <a href={urlFor("/")}>Techniques</a>
            <a href={urlFor("/kata/nage-no-kata/")}>Nage-no-kata</a>
            <a href={urlFor("/promotion/")}>Promotion</a>
            <a href={urlFor("/release-notes/")}>v1.0</a>
            <button class="theme-toggle" type="button" aria-label="Toggle color theme" data-theme-toggle>
              <span class="theme-toggle-thumb" aria-hidden="true"></span>
              <span>Light</span>
              <span>Dark</span>
            </button>
          </div>
        </nav>
      </header>
      <main class="shell page">
        <slot />
      </main>
      <FeedbackForm
        pageType={feedbackPageType}
        pageTitle={title}
        subjectSlug={feedbackSubjectSlug}
        subjectName={feedbackSubjectName}
      />
    </div>
    <script is:inline>
      const appRoot = document.querySelector("[data-technical-machine]");
      const themeToggle = appRoot?.querySelector("[data-theme-toggle]");
      const themePreference = window.matchMedia("(prefers-color-scheme: dark)");

      function currentTheme() {
        return appRoot?.dataset.theme || (themePreference.matches ? "dark" : "light");
      }

      function setTheme(theme) {
        const nextTheme = theme === "dark" ? "dark" : "light";
        if (appRoot) appRoot.dataset.theme = nextTheme;
        localStorage.setItem("judo-theme", nextTheme);
        themeToggle?.setAttribute("aria-pressed", String(nextTheme === "dark"));
      }

      themeToggle?.addEventListener("click", () => {
        setTheme(currentTheme() === "dark" ? "light" : "dark");
      });

      themeToggle?.setAttribute("aria-pressed", String(currentTheme() === "dark"));
    </script>
  </body>
</html>
