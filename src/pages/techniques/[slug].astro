---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  classifications,
  comboEdges,
  getLegality,
  getSafetyAdvisories,
  getTechnique,
  getTechniqueVideo,
  gripContexts,
  sources,
  techniques,
  variants
} from "../../query.mjs";

const baseUrl = import.meta.env.BASE_URL;
const urlFor = (path) => `${baseUrl.replace(/\/?$/, "/")}${path.replace(/^\//, "")}`;

export function getStaticPaths() {
  return techniques.map((technique) => ({
    params: { slug: technique.slug }
  }));
}

const technique = getTechnique(Astro.params.slug);

if (!technique) {
  return Astro.redirect("/");
}

const classificationLabels = technique.classifications.map((slug) => {
  const classification = classifications.find((item) => item.slug === slug);
  return classification ? `${classification.japaneseRomaji} · ${classification.english}` : slug;
});

const baseLegality = getLegality(technique.slug);
const baseAdvisories = getSafetyAdvisories(technique.slug);

const variantRows = variants
  .filter((variant) => variant.baseTechniqueSlug === technique.slug)
  .map((variant) => ({
    variant,
    legality: getLegality(variant.slug),
    advisories: getSafetyAdvisories(variant.slug)
  }));
const advisoryRows = [
  ...baseAdvisories.map((advisory) => ({
    advisory,
    label: technique.names.japaneseRomaji
  })),
  ...variantRows.flatMap(({ variant, advisories }) => (
    advisories.map((advisory) => ({
      advisory,
      label: variant.name
    }))
  ))
];

const gripContextSlugSet = new Set(technique.gripContextSlugs ?? []);
for (const { variant } of variantRows) {
  for (const slug of variant.gripContextSlugs ?? []) {
    gripContextSlugSet.add(slug);
  }
  for (const sequence of variant.directionSequences ?? []) {
    if (sequence.stanceContext && sequence.stanceContext !== "any") {
      gripContextSlugSet.add(sequence.stanceContext);
    }
  }
}
const gripContextRows = Array.from(gripContextSlugSet)
  .map((slug) => gripContexts.find((context) => context.slug === slug))
  .filter(Boolean);
const contextDisplayLabel = (context) => (
  context.shortGloss ? `${context.label} · ${context.shortGloss}` : context.label
);

const hasBasePhases = Object.keys(technique.phases).length > 0;
const variantTurnRelation = (variant) => {
  if (variant.chirality?.turnRelation) return variant.chirality.turnRelation;
  if (variant.actionFeatures?.includes("standard-turn")) return "standard";
  if (variant.actionFeatures?.includes("reverse-turn")) return "reverse";
  return undefined;
};
const variantTurnSummary = (variant) => {
  const relation = variantTurnRelation(variant);
  if (!relation && !variant.chirality?.toriSide && !variant.chirality?.turn) return undefined;

  return {
    relation,
    label: relation === "reverse" ? "Reverse-side turn" : relation === "standard" ? "Standard-side turn" : undefined,
    toriSide: variant.chirality?.toriSide,
    turn: variant.chirality?.turn
  };
};
const variantMechanicsRows = variantRows
  .filter((row) => row.variant.mechanics)
  .map((row) => ({
    ...row,
    turnSummary: variantTurnSummary(row.variant)
  }))
  .filter((row) => !(row.turnSummary?.relation && row.turnSummary.toriSide === "left"));

const outgoingEdgeRows = comboEdges
  .filter((edge) => edge.fromSlug === technique.slug || variantRows.some((row) => row.variant.slug === edge.fromSlug))
  .map((edge) => ({
    edge,
    direction: "outgoing",
    related: techniques.find((item) => item.slug === edge.toSlug) ?? variants.find((item) => item.slug === edge.toSlug)
  }));
const incomingEdgeRows = comboEdges
  .filter((edge) => edge.toSlug === technique.slug || variantRows.some((row) => row.variant.slug === edge.toSlug))
  .map((edge) => ({
    edge,
    direction: "incoming",
    related: techniques.find((item) => item.slug === edge.fromSlug) ?? variants.find((item) => item.slug === edge.fromSlug)
  }));
const relatedEdgeRows = [...outgoingEdgeRows, ...incomingEdgeRows]
  .filter((row, index, rows) => {
    const firstMatchingIndex = rows.findIndex((candidate) => (
      candidate.direction === row.direction &&
      candidate.edge.fromSlug === row.edge.fromSlug &&
      candidate.edge.toSlug === row.edge.toSlug &&
      candidate.edge.pattern === row.edge.pattern
    ));
    return firstMatchingIndex === index;
  });
const hasEscapeRole = technique.roles.includes("escape");
const edgePatternOrder = {
  "same-direction-pressure": 0,
  "alternating-direction-reaction": 1,
  "direct-follow-up": 2,
  "counter-sequence": 3
};
const edgeSort = (a, b) => {
  const patternDelta = (edgePatternOrder[a.edge.pattern] ?? 99) - (edgePatternOrder[b.edge.pattern] ?? 99);
  if (patternDelta !== 0) return patternDelta;
  const aName = a.related?.names?.japaneseRomaji ?? a.related?.name ?? a.edge.toSlug;
  const bName = b.related?.names?.japaneseRomaji ?? b.related?.name ?? b.edge.toSlug;
  return aName.localeCompare(bName);
};
const comboEdgeRows = relatedEdgeRows
  .filter((row) => row.edge.pattern !== "counter-sequence")
  .sort(edgeSort);
const counterEdgeRows = relatedEdgeRows
  .filter((row) => row.edge.pattern === "counter-sequence")
  .sort(edgeSort);
const comboSections = [
  {
    title: "Starts from this technique",
    subtitle: "Attacks that commonly follow this entry or pressure.",
    rows: comboEdgeRows.filter((row) => row.direction === "outgoing")
  },
  {
    title: "Leads into this technique",
    subtitle: "Sequences where this technique is the follow-up.",
    rows: comboEdgeRows.filter((row) => row.direction === "incoming")
  }
].filter((section) => section.rows.length > 0);
const counterSections = hasEscapeRole
  ? [
      {
        title: "Escapes from",
        subtitle: "Controls or attacks this defensive action answers.",
        rows: counterEdgeRows.filter((row) => row.direction === "incoming")
      },
      {
        title: "Follow-up counters",
        subtitle: "Responses that can follow this defensive action.",
        rows: counterEdgeRows.filter((row) => row.direction === "outgoing")
      }
    ].filter((section) => section.rows.length > 0)
  : [
      {
        title: "Answered by",
        subtitle: "Counters, escapes, or defenses against this technique.",
        rows: counterEdgeRows.filter((row) => row.direction === "outgoing")
      },
      {
        title: "Counters",
        subtitle: "Attacks this technique can answer.",
        rows: counterEdgeRows.filter((row) => row.direction === "incoming")
      }
    ].filter((section) => section.rows.length > 0);
const relatedEdgeLabel = (edge, direction) => {
  if (edge.pattern === "counter-sequence") {
    if (hasEscapeRole && direction === "incoming") return "Escapes from";
    if (!hasEscapeRole && direction === "outgoing") return "Answered by";
    return direction === "incoming" ? "Counter to" : "Counter";
  }
  if (edge.pattern === "same-direction-pressure") return "Same-direction combo";
  if (edge.pattern === "alternating-direction-reaction") return "Reaction combo";
  if (edge.pattern === "direct-follow-up") return "Follow-up";
  return edge.pattern;
};
const edgeRelatedHref = (related) => related?.names ? urlFor(`/techniques/${related.slug}/`) : undefined;
const edgeRelatedLabel = (row) => {
  if (row.related?.names) return row.related.names.japaneseRomaji;
  return row.related?.name ?? (row.direction === "outgoing" ? row.edge.toSlug : row.edge.fromSlug);
};

const techniqueVideo = getTechniqueVideo(technique.slug);
const techniqueVideoEmbedUrl = techniqueVideo ? `https://www.youtube.com/embed/${techniqueVideo.youtubeId}?rel=0` : undefined;
const techniqueVideoSourceUrl = techniqueVideo ? `https://www.youtube.com/watch?v=${techniqueVideo.youtubeId}&list=${techniqueVideo.playlistId}` : undefined;
const isAuthorEdited = false;
const correctionFormEndpoint = import.meta.env.PUBLIC_CORRECTION_FORM_ENDPOINT ?? "https://splitforms.com/api/submit";
const correctionFormAccessKey = import.meta.env.PUBLIC_SPLITFORMS_ACCESS_KEY ?? "";
const correctionFormEnabled = Boolean(correctionFormAccessKey);
const correctionPagePath = urlFor(`/techniques/${technique.slug}/`);
const correctionPageUrl = Astro.site ? new URL(correctionPagePath, Astro.site).href : correctionPagePath;
const techniqueVideoNote = technique.slug === "seoi-nage"
  ? "Seoi-nage is commonly encountered in English-language dojo shorthand as morote seoi-nage when both hands stay on the standard sleeve-and-lapel controls."
  : "Kodokan reference video from the 100 Techniques playlist.";
const sourceRows = Array.from(new Set([...technique.sourceIds, ...(techniqueVideo?.sourceIds ?? [])]))
  .map((id) => sources.find((source) => source.id === id))
  .filter(Boolean);
---

<BaseLayout title={`${technique.names.japaneseRomaji} · Technical Machine`}>
  <section class="intro" aria-labelledby="technique-title">
    <div>
      <p class="eyebrow">{classificationLabels[0]}</p>
      <h1 id="technique-title" class="detail-kanji">{technique.names.japanese}</h1>
      <p class="reading-line detail-reading">{technique.names.japaneseRomaji} · {technique.names.kana}</p>
      <p class="lede">{technique.names.english}</p>
    </div>
    <img class="mark" src={urlFor("/technical-machine-icon.svg")} alt="" width="150" height="150" />
  </section>

  <fieldset class="side-toggle detail-side-toggle" aria-label="Tori side">
    <legend>Tori side</legend>
    <div class="side-switch">
      <span class="side-switch-thumb" aria-hidden="true"></span>
      <button type="button" value="left" data-tori-side-toggle aria-pressed="false">
        <span>Left</span>
      </button>
      <button type="button" value="right" data-tori-side-toggle aria-pressed="true">
        <span>Right</span>
      </button>
    </div>
  </fieldset>

  <div class="detail-grid">
    <div>
      <section class="panel" aria-labelledby="facts-title">
        <h2 id="facts-title">Technique Facts</h2>
        <div class="facts">
          <div class="fact">
            <span>English</span>
            <strong>{technique.names.english}</strong>
          </div>
          <div class="fact">
            <span>Japanese</span>
            <strong>{technique.names.japanese} · {technique.names.kana}</strong>
          </div>
          <div class="fact">
            <span>Domain</span>
            <strong>{technique.domains.join(", ")}</strong>
          </div>
          <div class="fact">
            <span>Roles</span>
            <strong>{technique.roles.join(", ")}</strong>
          </div>
          {gripContextRows.length > 0 && (
            <div class="fact">
              <span>Grip / Position</span>
              <strong>{gripContextRows.map((context) => contextDisplayLabel(context)).join(", ")}</strong>
            </div>
          )}
        </div>
        <div class="tags">
          {technique.classifications.map((slug) => <span class="tag accent">{slug}</span>)}
          {gripContextRows.map((context) => <span class="tag">{contextDisplayLabel(context)}</span>)}
          {baseLegality?.status === "legal" && <span class="tag success">competition legal</span>}
          {baseLegality?.status === "illegal" && <span class="tag danger">competition banned</span>}
          {baseLegality?.status === "restricted" && <span class="tag danger">restricted</span>}
          {baseAdvisories.length > 0 && <span class="tag warning">safety note</span>}
          {techniqueVideo ? <span class="tag">video linked</span> : <span class="tag warning">video not linked</span>}
          {isAuthorEdited ? <span class="tag success">author edited</span> : <span class="tag warning">pending review</span>}
        </div>
      </section>

      <section class="panel" aria-labelledby="technique-video-title">
        <h2 id="technique-video-title">Technique Video</h2>
        {techniqueVideo ? (
          <>
          <h3>{techniqueVideo.title}</h3>
          <div class="video-embed">
            <iframe
              src={techniqueVideoEmbedUrl}
              title={techniqueVideo.title}
              loading="eager"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
          </div>
          <p class="source">
            {techniqueVideoNote} <a href={techniqueVideoSourceUrl}>Open on YouTube</a>.
          </p>
          </>
        ) : (
          <div class="video-placeholder">
            <strong>No embedded reference video mapped yet.</strong>
            <p>
              This section is reserved for a Kodokan reference clip or another reviewed source once this technique is mapped.
            </p>
          </div>
        )}
      </section>

      <section class="panel" aria-labelledby="phases-title">
        <h2 id="phases-title">Technique Theme</h2>
        {technique.mechanicsTheme ? (
          <p class="empty">{technique.mechanicsTheme}</p>
        ) : hasBasePhases ? (
          <p class="empty">Base-level mechanics have been captured, but variant-specific mechanics have not been added yet.</p>
        ) : (
          <p class="empty">Mechanics have not been added yet.</p>
        )}
      </section>

      <section class="panel" aria-labelledby="variant-mechanics-title">
        <h2 id="variant-mechanics-title">Mechanics By Variant</h2>
        {variantMechanicsRows.length > 0 ? (
          <div class="variant-mechanics">
            {variantMechanicsRows.map(({ variant, legality, turnSummary }) => (
              <article class="mechanics-card">
                <div class="mechanics-heading">
                  <div>
                    <h3>{variant.name}</h3>
                    {turnSummary && (
                      <p class="chiral-note">
                        {turnSummary.label}
                        {turnSummary.toriSide && (
                          <>
                            {" · "}
                            <span data-tori-side-label data-canonical-tori-side={turnSummary.toriSide}>{turnSummary.toriSide}</span> tori
                          </>
                        )}
                        {turnSummary.turn && (
                          <>
                            {" · "}
                            <span data-direction-label data-canonical-direction={turnSummary.turn}>{turnSummary.turn}</span>
                          </>
                        )}
                      </p>
                    )}
                  </div>
                  {legality?.status === "legal" && <span class="tag success">competition legal</span>}
                  {legality?.status === "illegal" && <span class="tag danger">banned variant</span>}
                  {legality?.status === "restricted" && <span class="tag danger">restricted</span>}
                </div>
                <div class="phase-list">
                  {["kuzushi", "tsukuri", "kake"].map((phaseName) => variant.mechanics[phaseName] && (
                    <article class="phase">
                      <h3>{phaseName}</h3>
                      <p>{variant.mechanics[phaseName].summary}</p>
                      {variant.mechanics[phaseName].directionHints && (
                        <div class="tags">
                          {variant.mechanics[phaseName].directionHints.map((direction) => (
                            <span class="tag" data-direction-label data-canonical-direction={direction}>{direction}</span>
                          ))}
                        </div>
                      )}
                    </article>
                  ))}
                </div>
                {variant.mechanics.directionSequences && (
                  <div class="direction-strip">
                    {variant.mechanics.directionSequences.map((sequence) => (
                      <div>
                        <span class="mini-label">{sequence.stanceContext} · <span data-tori-side-label data-canonical-tori-side={sequence.toriSide}>{sequence.toriSide}</span></span>
                        <div class="tags">
                          {sequence.directions.map((direction) => (
                            <span class="tag" data-direction-label data-canonical-direction={direction}>{direction}</span>
                          ))}
                        </div>
                      </div>
                    ))}
                  </div>
                )}
              </article>
            ))}
          </div>
        ) : hasBasePhases ? (
          <div class="phase-list">
            {["kuzushi", "tsukuri", "kake"].map((phaseName) => technique.phases[phaseName] && (
              <article class="phase">
                <h3>{phaseName}</h3>
                <p>{technique.phases[phaseName].summary}</p>
                {technique.phases[phaseName].directionHints && (
                  <div class="tags">
                    {technique.phases[phaseName].directionHints.map((direction) => (
                      <span class="tag" data-direction-label data-canonical-direction={direction}>{direction}</span>
                    ))}
                  </div>
                )}
              </article>
            ))}
          </div>
        ) : (
          <p class="empty">Variant mechanics have not been added yet.</p>
        )}
      </section>

      <section class="panel" aria-labelledby="combos-title">
        <h2 id="combos-title">Combinations</h2>
        {comboSections.length > 0 ? (
          <div class="relationship-section-list">
            {comboSections.map((section) => (
              <section class="relationship-section">
                <div class="relationship-heading">
                  <h3>{section.title}</h3>
                  <p>{section.subtitle}</p>
                </div>
                <ul class="list relationship-list">
                  {section.rows.map((row) => (
                    <li>
                      <strong>{relatedEdgeLabel(row.edge, row.direction)}</strong>
                      <div class="source">
                        {edgeRelatedHref(row.related) ? (
                          <a href={edgeRelatedHref(row.related)}>{edgeRelatedLabel(row)}</a>
                        ) : (
                          edgeRelatedLabel(row)
                        )}
                        {row.edge.firstPressureDirection && (
                          <>
                            {" · pressure "}
                            <span data-direction-label data-canonical-direction={row.edge.firstPressureDirection}>{row.edge.firstPressureDirection}</span>
                          </>
                        )}
                        {row.edge.expectedUkeReaction && (
                          <>
                            {" · reaction "}
                            <span data-direction-label data-canonical-direction={row.edge.expectedUkeReaction}>{row.edge.expectedUkeReaction}</span>
                          </>
                        )}
                        {row.edge.finishingDirection && (
                          <>
                            {" · finish "}
                            <span data-direction-label data-canonical-direction={row.edge.finishingDirection}>{row.edge.finishingDirection}</span>
                          </>
                        )}
                      </div>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        ) : (
          <p class="empty">No combination edges have been added yet.</p>
        )}
      </section>

      <section class="panel" aria-labelledby="counters-title">
        <h2 id="counters-title">Counters / Defenses</h2>
        {counterSections.length > 0 ? (
          <div class="relationship-section-list">
            {counterSections.map((section) => (
              <section class="relationship-section">
                <div class="relationship-heading">
                  <h3>{section.title}</h3>
                  <p>{section.subtitle}</p>
                </div>
                <ul class="list relationship-list">
                  {section.rows.map((row) => (
                    <li>
                      <strong>{relatedEdgeLabel(row.edge, row.direction)}</strong>
                      <div class="source">
                        {edgeRelatedHref(row.related) ? (
                          <a href={edgeRelatedHref(row.related)}>{edgeRelatedLabel(row)}</a>
                        ) : (
                          edgeRelatedLabel(row)
                        )}
                        {row.edge.firstPressureDirection && (
                          <>
                            {" · pressure "}
                            <span data-direction-label data-canonical-direction={row.edge.firstPressureDirection}>{row.edge.firstPressureDirection}</span>
                          </>
                        )}
                        {row.edge.expectedUkeReaction && (
                          <>
                            {" · reaction "}
                            <span data-direction-label data-canonical-direction={row.edge.expectedUkeReaction}>{row.edge.expectedUkeReaction}</span>
                          </>
                        )}
                        {row.edge.finishingDirection && (
                          <>
                            {" · finish "}
                            <span data-direction-label data-canonical-direction={row.edge.finishingDirection}>{row.edge.finishingDirection}</span>
                          </>
                        )}
                      </div>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        ) : (
          <p class="empty">No counter or defense edges have been added yet.</p>
        )}
      </section>
    </div>

    <aside>
      <section class="panel" aria-labelledby="safety-title">
        <h2 id="safety-title">Safety Advisories</h2>
        {advisoryRows.length > 0 ? (
          <ul class="list">
            {advisoryRows.map(({ advisory, label }) => (
              <li>
                <strong>{label}</strong>
                <div class="source">
                  {advisory.level} · {advisory.context.join(", ")} · {advisory.authority}
                </div>
                <div class="tags">
                  {advisory.reasons.map((reason) => (
                    <span class={`tag ${advisory.level === "banned-in-competition" ? "danger" : "warning"}`}>{reason}</span>
                  ))}
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">No safety advisory has been added yet.</p>
        )}
      </section>

      <section class="panel" aria-labelledby="variants-title">
        <h2 id="variants-title">Variants</h2>
        {variantRows.length > 0 ? (
          <ul class="list">
            {variantRows.map(({ variant, legality, advisories }) => (
              <li>
                <strong>{variant.name}</strong>
                {variantTurnSummary(variant) && (
                  <div class="source">
                    {variantTurnSummary(variant).label}
                    {variantTurnSummary(variant).toriSide && (
                      <>
                        {" · "}
                        {variantTurnSummary(variant).toriSide} tori
                      </>
                    )}
                    {variantTurnSummary(variant).turn && (
                      <>
                        {" · "}
                        {variantTurnSummary(variant).turn}
                      </>
                    )}
                  </div>
                )}
                <div class="source">
                  {legality ? `${legality.status} · ${legality.reasons.join(", ")}` : "No legality record"}
                </div>
                {legality?.status === "legal" && (
                  <div class="tags">
                    <span class="tag success">competition legal</span>
                  </div>
                )}
                {advisories.length > 0 && (
                  <div class="tags">
                    {advisories.map((advisory) => <span class={`tag ${advisory.level === "banned-in-competition" ? "danger" : "warning"}`}>{advisory.level}</span>)}
                  </div>
                )}
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">No variants have been added yet.</p>
        )}
      </section>

      <section class="panel" aria-labelledby="sources-title">
        <h2 id="sources-title">Sources</h2>
        <ul class="list">
          {sourceRows.map((source) => (
            <li>
              <strong>{source.title}</strong>
              <div class="source">
                {source.publisher}
                {source.url && <> · <a href={source.url}>source</a></>}
              </div>
            </li>
          ))}
        </ul>
      </section>
    </aside>
  </div>

  <button class="correction-trigger" type="button" data-correction-open aria-controls="correction-dialog">
    <span class="correction-trigger-full">Submit feedback</span>
    <span class="correction-trigger-short">Feedback</span>
  </button>

  <dialog class="correction-dialog" id="correction-dialog" aria-labelledby="correction-title">
    <form
      class="correction-form"
      action={correctionFormEndpoint}
      method="POST"
      data-correction-form
      data-enabled={correctionFormEnabled ? "true" : "false"}
    >
      <input type="hidden" name="access_key" value={correctionFormAccessKey} />
      <input type="hidden" name="form_name" value="Technical Machine correction" />
      <input type="hidden" name="technique_slug" value={technique.slug} />
      <input type="hidden" name="technique_name" value={technique.names.japaneseRomaji} />
      <input type="hidden" name="page_url" value={correctionPageUrl} data-correction-page-url />
      <label class="sr-only" for="correction-botcheck">Leave this unchecked</label>
      <input id="correction-botcheck" type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" />

      <div class="correction-header">
        <div>
          <p class="eyebrow">Anonymous feedback</p>
          <h2 id="correction-title">Suggest a correction</h2>
          <p>
            Tell me what looks off on {technique.names.japaneseRomaji}. Sources are welcome, but optional.
          </p>
        </div>
        <button class="icon-button" type="button" data-correction-close aria-label="Close correction form">x</button>
      </div>

      {!correctionFormEnabled && (
        <p class="correction-status warning">
          Add <code>PUBLIC_SPLITFORMS_ACCESS_KEY</code> to enable submissions.
        </p>
      )}

      <label for="correction-area">
        <span>Area</span>
      </label>
      <select id="correction-area" name="area">
          <option value="name-translation">Name / translation</option>
          <option value="mechanics">Mechanics</option>
          <option value="safety-legality">Safety / legality</option>
          <option value="video">Video</option>
          <option value="promotion-requirement">Promotion requirement</option>
          <option value="combo-counter">Combo / counter</option>
          <option value="other">Other</option>
      </select>

      <label for="correction-message">
        <span>What seems wrong?</span>
      </label>
      <textarea id="correction-message" name="message" rows="5" required placeholder="Example: the kuzushi direction seems wrong for right-handed tori."></textarea>

      <label for="correction-suggestion">
        <span>Suggested correction</span>
      </label>
      <textarea id="correction-suggestion" name="suggested_correction" rows="3" placeholder="What should it say instead?"></textarea>

      <label for="correction-source-url">
        <span>Source link</span>
      </label>
      <input id="correction-source-url" name="source_url" type="url" placeholder="https://..." />

      <label for="correction-contact-email">
        <span>Email, optional</span>
      </label>
      <input id="correction-contact-email" name="contact_email" type="email" placeholder="Only if you want a follow-up." />

      <p class="correction-status" data-correction-status aria-live="polite"></p>

      <div class="correction-actions">
        <button class="clear-filters" type="button" data-correction-close>Cancel</button>
        <button class="preset-chip" type="submit" disabled={!correctionFormEnabled}>Send correction</button>
      </div>
    </form>
  </dialog>

  <script>
    const directionMirrorMap = {
      "front-right": "front-left",
      "front-left": "front-right",
      "back-right": "back-left",
      "back-left": "back-right",
      "clockwise": "counter-clockwise",
      "counter-clockwise": "clockwise"
    };
    const toriSideMirrorMap = {
      right: "left",
      left: "right"
    };
    const directionLabels = Array.from(document.querySelectorAll("[data-direction-label]"));
    const toriSideLabels = Array.from(document.querySelectorAll("[data-tori-side-label]"));
    const toriSideToggles = Array.from(document.querySelectorAll("[data-tori-side-toggle]"));
    const appRoot = document.querySelector("[data-technical-machine]");
    const correctionDialog = document.querySelector("#correction-dialog");
    const correctionOpen = document.querySelector("[data-correction-open]");
    const correctionCloseButtons = Array.from(document.querySelectorAll("[data-correction-close]"));
    const correctionForm = document.querySelector("[data-correction-form]");
    const correctionStatus = document.querySelector("[data-correction-status]");
    const correctionPageUrl = document.querySelector("[data-correction-page-url]");
    const storedToriSide = localStorage.getItem("judo-tori-side") ?? "right";

    function mirrorValue(value, map, side) {
      if (side !== "left") return value;
      return map[value] ?? value;
    }

    function setToriSide(side) {
      const nextSide = side === "left" ? "left" : "right";
      if (appRoot instanceof HTMLElement) appRoot.dataset.toriSide = nextSide;
      localStorage.setItem("judo-tori-side", nextSide);

      for (const label of directionLabels) {
        if (!(label instanceof HTMLElement)) continue;
        label.textContent = mirrorValue(label.dataset.canonicalDirection ?? "", directionMirrorMap, nextSide);
      }
      for (const label of toriSideLabels) {
        if (!(label instanceof HTMLElement)) continue;
        label.textContent = mirrorValue(label.dataset.canonicalToriSide ?? "", toriSideMirrorMap, nextSide);
      }
      for (const toggle of toriSideToggles) {
        if (toggle instanceof HTMLButtonElement) {
          toggle.setAttribute("aria-pressed", toggle.value === nextSide ? "true" : "false");
        }
      }
    }

    setToriSide(storedToriSide);

    for (const toggle of toriSideToggles) {
      toggle.addEventListener("click", () => {
        if (toggle instanceof HTMLButtonElement) setToriSide(toggle.value);
      });
    }

    if (correctionPageUrl instanceof HTMLInputElement) {
      correctionPageUrl.value = window.location.href;
    }

    correctionOpen?.addEventListener("click", () => {
      if (correctionDialog instanceof HTMLDialogElement) correctionDialog.showModal();
    });

    for (const button of correctionCloseButtons) {
      button.addEventListener("click", () => {
        if (correctionDialog instanceof HTMLDialogElement) correctionDialog.close();
      });
    }

    correctionDialog?.addEventListener("click", (event) => {
      if (event.target === correctionDialog && correctionDialog instanceof HTMLDialogElement) {
        correctionDialog.close();
      }
    });

    correctionForm?.addEventListener("submit", async (event) => {
      if (!(correctionForm instanceof HTMLFormElement)) return;
      if (correctionForm.dataset.enabled !== "true") {
        event.preventDefault();
        if (correctionStatus instanceof HTMLElement) {
          correctionStatus.textContent = "Correction submissions need a Splitforms access key first.";
          correctionStatus.className = "correction-status warning";
        }
        return;
      }

      event.preventDefault();
      if (correctionStatus instanceof HTMLElement) {
        correctionStatus.textContent = "Sending...";
        correctionStatus.className = "correction-status";
      }

      try {
        const response = await fetch(correctionForm.action, {
          method: correctionForm.method,
          body: new FormData(correctionForm),
          headers: { Accept: "application/json" }
        });

        if (!response.ok) throw new Error("Submission failed");
        correctionForm.reset();
        if (correctionStatus instanceof HTMLElement) {
          correctionStatus.textContent = "Thank you. I'll review this correction.";
          correctionStatus.className = "correction-status success";
        }
      } catch {
        if (correctionStatus instanceof HTMLElement) {
          correctionStatus.textContent = "Something went wrong. Please try again in a moment.";
          correctionStatus.className = "correction-status warning";
        }
      }
    });
  </script>
</BaseLayout>
