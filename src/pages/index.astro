---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  classifications,
  getLegality,
  getSafetyAdvisories,
  getVariantsFor,
  techniques
} from "../query.mjs";

const nageTechniques = techniques.filter((technique) => technique.classifications.includes("nage-waza"));
const groups = ["te-waza", "koshi-waza", "ashi-waza", "ma-sutemi-waza", "yoko-sutemi-waza"];
const groupMeta = groups.map((slug) => ({
  slug,
  label: classifications.find((item) => item.slug === slug)?.japaneseRomaji ?? slug,
  english: classifications.find((item) => item.slug === slug)?.english ?? slug,
  count: nageTechniques.filter((technique) => technique.classifications.includes(slug)).length
}));

const cards = nageTechniques
  .slice()
  .sort((a, b) => a.names.japaneseRomaji.localeCompare(b.names.japaneseRomaji))
  .map((technique) => {
    const primaryGroup = groups.find((group) => technique.classifications.includes(group)) ?? "other";
    const variants = getVariantsFor(technique.slug);
    const variantLegalityRows = variants.map((variant) => ({
      variant,
      legality: getLegality(variant.slug)
    }));
    const legalityStatuses = variantLegalityRows.map((row) => row.legality?.status).filter(Boolean);
    const legalVariantCount = variantLegalityRows.filter((row) => row.legality?.status === "legal").length;
    const bannedVariantCount = variantLegalityRows.filter((row) => row.legality?.status === "illegal").length;
    const restrictedVariantCount = variantLegalityRows.filter((row) => row.legality?.status === "restricted").length;
    const classicBanned = variantLegalityRows.some((row) => (
      row.legality?.status === "illegal" &&
      row.variant.modifiers.some((modifier) => ["classic", "traditional"].includes(modifier))
    ));
    const hasCompetitionLegalRecord = legalVariantCount > 0;
    const hasMixedLegality = hasCompetitionLegalRecord && (bannedVariantCount > 0 || restrictedVariantCount > 0);
    const advisories = variants.flatMap((variant) => getSafetyAdvisories(variant.slug));
    const filterFlags = [
      variants.length > 0 && "has-variants",
      hasCompetitionLegalRecord && "competition-legal",
      bannedVariantCount > 0 && "banned-variant",
      classicBanned && "classic-banned",
      restrictedVariantCount > 0 && "restricted-variant",
      hasMixedLegality && "mixed-legality",
      advisories.length > 0 && "safety-note"
    ].filter(Boolean).join(" ");
    return {
      technique,
      primaryGroup,
      variants,
      legalityStatuses,
      hasCompetitionLegalRecord,
      legalVariantCount,
      bannedVariantCount,
      restrictedVariantCount,
      classicBanned,
      hasMixedLegality,
      advisories,
      roles: technique.roles.join(" "),
      filterFlags,
      searchText: [
        technique.slug,
        technique.names.english,
        technique.names.japaneseRomaji,
        technique.names.japanese,
        technique.names.kana,
        ...technique.names.aliases,
        ...technique.classifications
      ].join(" ").toLowerCase()
    };
  });
---

<BaseLayout title="Judo Throw Browser">
  <section class="intro" aria-labelledby="page-title">
    <div>
      <p class="eyebrow">Nage-waza catalog</p>
      <h1 id="page-title">Judo throws, grouped by technique family.</h1>
      <p class="lede">
        {nageTechniques.length} throws with Japanese names, kana, classifications, variants, legality notes, safety advisories, and combo hooks.
      </p>
    </div>
    <img class="mark" src="/judo-graph-mark.svg" alt="" width="150" height="150" />
  </section>

  <section class="stats" aria-label="Throw groups">
    {groupMeta.map((group) => (
      <a class="stat" href={`/?group=${group.slug}`} data-group-link={group.slug}>
        <strong>{group.count}</strong>
        <span>{group.label} · {group.english}</span>
      </a>
    ))}
  </section>

  <section aria-label="Technique controls">
    <div class="toolbar">
      <input class="field" id="technique-search" type="search" placeholder="Search English, romaji, kana, kanji, alias" autocomplete="off" />
      <select class="select" id="group-filter">
        <option value="all">All groups</option>
        {groupMeta.map((group) => (
          <option value={group.slug}>{group.label} · {group.english}</option>
        ))}
      </select>
      <fieldset class="toggle-group" aria-label="Technique filters">
        <label class="toggle">
          <input type="checkbox" value="attack" data-role-toggle />
          <span>Attacks</span>
        </label>
        <label class="toggle">
          <input type="checkbox" value="counter" data-role-toggle />
          <span>Counters</span>
        </label>
        <label class="toggle">
          <input type="checkbox" value="transition" data-role-toggle />
          <span>Transitions</span>
        </label>
        <label class="toggle">
          <input type="checkbox" value="escape" data-role-toggle />
          <span>Escapes</span>
        </label>
        <label class="toggle">
          <input type="checkbox" value="has-variants" data-status-toggle />
          <span>Has variants</span>
        </label>
        <label class="toggle success-toggle">
          <input type="checkbox" value="competition-legal" data-status-toggle />
          <span>Competition legal</span>
        </label>
        <label class="toggle danger-toggle">
          <input type="checkbox" value="banned-variant" data-status-toggle />
          <span>Banned variant</span>
        </label>
        <label class="toggle danger-toggle">
          <input type="checkbox" value="classic-banned" data-status-toggle />
          <span>Classic banned</span>
        </label>
        <label class="toggle danger-toggle">
          <input type="checkbox" value="restricted-variant" data-status-toggle />
          <span>Restricted</span>
        </label>
        <label class="toggle mixed-toggle">
          <input type="checkbox" value="mixed-legality" data-status-toggle />
          <span>Mixed legality</span>
        </label>
        <label class="toggle warning-toggle">
          <input type="checkbox" value="safety-note" data-status-toggle />
          <span>Safety note</span>
        </label>
        <button class="clear-filters" type="button" id="clear-filters">Clear all</button>
      </fieldset>
    </div>
  </section>

  <section class="technique-grid" id="technique-grid" aria-label="Techniques">
    {cards.map(({
      technique,
      primaryGroup,
      variants,
      legalityStatuses,
      hasCompetitionLegalRecord,
      legalVariantCount,
      bannedVariantCount,
      restrictedVariantCount,
      classicBanned,
      hasMixedLegality,
      advisories,
      roles,
      filterFlags,
      searchText
    }) => (
      <article
        class="technique-card"
        data-technique-card
        data-group={primaryGroup}
        data-roles={roles}
        data-filters={filterFlags}
        data-search={searchText}
      >
        <div class="card-top">
          <div>
            <a class="name-stack" href={`/techniques/${technique.slug}/`}>
              <span class="kanji-title">{technique.names.japanese}</span>
              <span class="reading-line">{technique.names.japaneseRomaji} · {technique.names.kana}</span>
            </a>
            <div class="english-name">
              {technique.names.english}
            </div>
          </div>
          <span class="tag accent">{primaryGroup}</span>
        </div>
        <div class="tags">
          {technique.roles.map((role) => <span class="tag">{role}</span>)}
          {variants.length > 0 && <span class="tag">{variants.length} variants</span>}
          {hasCompetitionLegalRecord && <span class="tag success">{legalVariantCount} legal variant{legalVariantCount === 1 ? "" : "s"}</span>}
          {classicBanned && <span class="tag danger">classic banned</span>}
          {!classicBanned && bannedVariantCount > 0 && <span class="tag danger">{bannedVariantCount} banned variant{bannedVariantCount === 1 ? "" : "s"}</span>}
          {restrictedVariantCount > 0 && <span class="tag danger">{restrictedVariantCount} restricted variant{restrictedVariantCount === 1 ? "" : "s"}</span>}
          {hasMixedLegality && <span class="tag mixed">mixed legality</span>}
          {advisories.length > 0 && <span class="tag warning">safety note</span>}
        </div>
      </article>
    ))}
  </section>

  <script>
    const search = document.querySelector("#technique-search");
    const groupFilter = document.querySelector("#group-filter");
    const roleToggles = Array.from(document.querySelectorAll("[data-role-toggle]"));
    const statusToggles = Array.from(document.querySelectorAll("[data-status-toggle]"));
    const clearFilters = document.querySelector("#clear-filters");
    const cards = Array.from(document.querySelectorAll("[data-technique-card]"));
    const params = new URLSearchParams(window.location.search);
    const initialGroup = params.get("group");

    if (initialGroup && groupFilter instanceof HTMLSelectElement) {
      groupFilter.value = initialGroup;
    }

    function applyFilters() {
      const term = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : "";
      const group = groupFilter instanceof HTMLSelectElement ? groupFilter.value : "all";
      const selectedRoles = roleToggles
        .filter((toggle) => toggle instanceof HTMLInputElement && toggle.checked)
        .map((toggle) => toggle.value);
      const selectedStatuses = statusToggles
        .filter((toggle) => toggle instanceof HTMLInputElement && toggle.checked)
        .map((toggle) => toggle.value);

      for (const card of cards) {
        const matchesText = !term || card.dataset.search?.includes(term);
        const matchesGroup = group === "all" || card.dataset.group === group;
        const cardRoles = card.dataset.roles?.split(" ") ?? [];
        const cardFilters = card.dataset.filters?.split(" ").filter(Boolean) ?? [];
        const matchesRoles = selectedRoles.every((role) => cardRoles.includes(role));
        const matchesStatuses = selectedStatuses.every((status) => cardFilters.includes(status));
        card.hidden = !(matchesText && matchesGroup && matchesRoles && matchesStatuses);
      }
    }

    search?.addEventListener("input", applyFilters);
    groupFilter?.addEventListener("change", applyFilters);
    for (const toggle of roleToggles) {
      toggle.addEventListener("change", applyFilters);
    }
    for (const toggle of statusToggles) {
      toggle.addEventListener("change", applyFilters);
    }
    clearFilters?.addEventListener("click", () => {
      if (search instanceof HTMLInputElement) search.value = "";
      if (groupFilter instanceof HTMLSelectElement) groupFilter.value = "all";

      for (const toggle of [...roleToggles, ...statusToggles]) {
        if (toggle instanceof HTMLInputElement) toggle.checked = false;
      }

      applyFilters();
    });
    applyFilters();
  </script>
</BaseLayout>
