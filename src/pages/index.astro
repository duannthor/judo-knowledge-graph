---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  classifications,
  comboEdges,
  getLegality,
  getSafetyAdvisories,
  getTechniqueVideo,
  getVariantsFor,
  gripContexts,
  kataMemberships,
  promotionRequirements,
  techniques,
  variants
} from "../query.mjs";

const baseUrl = import.meta.env.BASE_URL;
const urlFor = (path) => `${baseUrl.replace(/\/?$/, "/")}${path.replace(/^\//, "")}`;
const browsableTechniques = techniques;
const groups = [
  "te-waza",
  "koshi-waza",
  "ashi-waza",
  "ma-sutemi-waza",
  "yoko-sutemi-waza",
  "osaekomi-waza",
  "shime-waza",
  "kansetsu-waza"
];
const groupMeta = groups.map((slug) => ({
  slug,
  label: classifications.find((item) => item.slug === slug)?.japaneseRomaji ?? slug,
  english: classifications.find((item) => item.slug === slug)?.english ?? slug,
  kanji: classifications.find((item) => item.slug === slug)?.japanese ?? "",
  count: browsableTechniques.filter((technique) => technique.classifications.includes(slug)).length
}));
const familyDisplay = {
  "te-waza": { kanji: "手", english: "hand" },
  "koshi-waza": { kanji: "腰", english: "hip" },
  "ashi-waza": { kanji: "足", english: "foot/leg" },
  "ma-sutemi-waza": { kanji: "真捨身", english: "rear sacrifice" },
  "yoko-sutemi-waza": { kanji: "横捨身", english: "side sacrifice" },
  "osaekomi-waza": { kanji: "抑込", english: "hold-down" },
  "shime-waza": { kanji: "絞", english: "choke" },
  "kansetsu-waza": { kanji: "関節", english: "joint lock" }
};
const familyGroups = [
  {
    title: "Nage-waza",
    kanji: "投技",
    english: "throwing techniques",
    groups: groupMeta.filter((group) => ["te-waza", "koshi-waza", "ashi-waza", "ma-sutemi-waza", "yoko-sutemi-waza"].includes(group.slug))
  },
  {
    title: "Katame-waza",
    kanji: "固技",
    english: "grappling techniques",
    groups: groupMeta.filter((group) => ["osaekomi-waza", "shime-waza", "kansetsu-waza"].includes(group.slug))
  }
];
const contextFilterGroups = [
  {
    title: "Standing",
    contexts: gripContexts.filter((context) => context.phase === "standing")
  },
  {
    title: "Ground",
    contexts: gripContexts.filter((context) => context.phase === "ground")
  }
];
const promotionRequirementLabel = "USJF Senior Promotion Requirements, 2026";
const promotionRanks = promotionRequirements
  .slice()
  .sort((a, b) => a.band - b.band);
const kataFilters = kataMemberships.filter((kata) => kata.id === "nage-no-kata");
const contextDisplayLabel = (context) => (
  context.shortGloss ? `${context.label} · ${context.shortGloss}` : context.label
);
const kodokanTechniqueOrder = [
  "seoi-nage",
  "ippon-seoi-nage",
  "seoi-otoshi",
  "tai-otoshi",
  "kata-guruma",
  "sukui-nage",
  "obi-otoshi",
  "uki-otoshi",
  "sumi-otoshi",
  "yama-arashi",
  "obi-tori-gaeshi",
  "morote-gari",
  "kuchiki-taoshi",
  "kibisu-gaeshi",
  "uchi-mata-sukashi",
  "ko-uchi-gaeshi",
  "uki-goshi",
  "o-goshi",
  "koshi-guruma",
  "tsurikomi-goshi",
  "sode-tsurikomi-goshi",
  "harai-goshi",
  "tsuri-goshi",
  "hane-goshi",
  "utsuri-goshi",
  "ushiro-goshi",
  "de-ashi-harai",
  "hiza-guruma",
  "sasae-tsurikomi-ashi",
  "o-soto-gari",
  "o-uchi-gari",
  "ko-soto-gari",
  "ko-uchi-gari",
  "okuri-ashi-harai",
  "uchi-mata",
  "ko-soto-gake",
  "ashi-guruma",
  "harai-tsurikomi-ashi",
  "o-guruma",
  "o-soto-guruma",
  "o-soto-otoshi",
  "tsubame-gaeshi",
  "o-soto-gaeshi",
  "o-uchi-gaeshi",
  "hane-goshi-gaeshi",
  "harai-goshi-gaeshi",
  "uchi-mata-gaeshi",
  "tomoe-nage",
  "sumi-gaeshi",
  "hikikomi-gaeshi",
  "tawara-gaeshi",
  "ura-nage",
  "yoko-otoshi",
  "tani-otoshi",
  "hane-makikomi",
  "soto-makikomi",
  "uchi-makikomi",
  "uki-waza",
  "yoko-wakare",
  "yoko-guruma",
  "yoko-gake",
  "daki-wakare",
  "o-soto-makikomi",
  "uchi-mata-makikomi",
  "harai-makikomi",
  "ko-uchi-makikomi",
  "kani-basami",
  "kawazu-gake",
  "kesa-gatame",
  "kuzure-kesa-gatame",
  "ushiro-kesa-gatame",
  "kata-gatame",
  "kami-shiho-gatame",
  "kuzure-kami-shiho-gatame",
  "yoko-shiho-gatame",
  "tate-shiho-gatame",
  "uki-gatame",
  "ura-gatame",
  "nami-juji-jime",
  "gyaku-juji-jime",
  "kata-juji-jime",
  "hadaka-jime",
  "okuri-eri-jime",
  "kataha-jime",
  "katate-jime",
  "ryote-jime",
  "sode-guruma-jime",
  "tsukkomi-jime",
  "sankaku-jime",
  "do-jime",
  "ude-garami",
  "ude-hishigi-juji-gatame",
  "ude-hishigi-ude-gatame",
  "ude-hishigi-hiza-gatame",
  "ude-hishigi-waki-gatame",
  "ude-hishigi-hara-gatame",
  "ude-hishigi-ashi-gatame",
  "ude-hishigi-te-gatame",
  "ude-hishigi-sankaku-gatame",
  "ashi-garami"
];
const kodokanOrderMap = new Map(kodokanTechniqueOrder.map((slug, index) => [slug, index + 1]));
const techniqueSlugSet = new Set(browsableTechniques.map((technique) => technique.slug));
const variantBaseSlugBySlug = new Map(variants.map((variant) => [variant.slug, variant.baseTechniqueSlug]));
const resolveTechniqueSlug = (slug) => techniqueSlugSet.has(slug)
  ? slug
  : variantBaseSlugBySlug.get(slug);
const attachmentRows = [];
const addAttachment = (anchorSlug, relatedSlug) => {
  if (!techniqueSlugSet.has(anchorSlug) || !techniqueSlugSet.has(relatedSlug) || anchorSlug === relatedSlug) return;
  attachmentRows.push({ anchorSlug, relatedSlug });
};
for (const edge of comboEdges) {
  if (edge.pattern !== "counter-sequence") continue;
  if (!techniqueSlugSet.has(edge.fromSlug)) continue;
  const anchorSlug = edge.fromSlug;
  const relatedSlug = resolveTechniqueSlug(edge.toSlug);
  if (anchorSlug && relatedSlug) addAttachment(anchorSlug, relatedSlug);
}
for (const [anchorSlug, relatedSlugs] of Object.entries({
  "seoi-nage": ["eri-seoi-nage"],
  "tsuri-goshi": ["o-tsuri-goshi", "ko-tsuri-goshi"],
  "kesa-gatame": ["makura-kesa-gatame"],
  "yoko-shiho-gatame": ["kuzure-yoko-shiho-gatame"]
})) {
  for (const relatedSlug of relatedSlugs) addAttachment(anchorSlug, relatedSlug);
}
const attachedByRelatedSlug = new Map();
for (const { anchorSlug, relatedSlug } of attachmentRows) {
  const anchorOrder = kodokanOrderMap.get(anchorSlug) ?? 10000;
  const existing = attachedByRelatedSlug.get(relatedSlug);
  if (!existing || anchorOrder > existing.anchorOrder) {
    attachedByRelatedSlug.set(relatedSlug, { anchorSlug, anchorOrder });
  }
}
const attachedSiblingRows = new Map();
for (const { anchorSlug, relatedSlug } of attachmentRows) {
  const attached = attachedByRelatedSlug.get(relatedSlug);
  if (attached?.anchorSlug !== anchorSlug) continue;
  attachedSiblingRows.set(anchorSlug, [...(attachedSiblingRows.get(anchorSlug) ?? []), relatedSlug]);
}
const attachedOffsetBySlug = new Map();
for (const [anchorSlug, relatedSlugs] of attachedSiblingRows) {
  const deduped = Array.from(new Set(relatedSlugs));
  deduped.sort((a, b) => {
    const aOfficial = kodokanOrderMap.get(a) ?? 10000;
    const bOfficial = kodokanOrderMap.get(b) ?? 10000;
    if (aOfficial !== bOfficial) return aOfficial - bOfficial;
    return a.localeCompare(b);
  });
  deduped.forEach((slug, index) => attachedOffsetBySlug.set(slug, index + 1));
}
const catalogSortValue = (technique) => {
  const attached = attachedByRelatedSlug.get(technique.slug);
  if (attached) {
    return attached.anchorOrder + ((attachedOffsetBySlug.get(technique.slug) ?? 99) / 100);
  }
  return kodokanOrderMap.get(technique.slug) ?? 10000;
};
const compareCatalogTechniques = (a, b) => {
  const orderDelta = catalogSortValue(a) - catalogSortValue(b);
  if (orderDelta !== 0) return orderDelta;
  return a.names.japaneseRomaji.localeCompare(b.names.japaneseRomaji);
};

const cards = browsableTechniques
  .slice()
  .sort(compareCatalogTechniques)
  .map((technique) => {
    const normalizeAlias = (value) => value.toLowerCase().replace(/[^a-z0-9]/g, "");
    const hiddenAliasForms = new Set([
      normalizeAlias(technique.names.japaneseRomaji),
      normalizeAlias(technique.names.english)
    ]);
    const displayAliases = technique.names.aliases
      .filter((alias) => !hiddenAliasForms.has(normalizeAlias(alias)))
      .slice(0, 3);
    const primaryGroup = groups.find((group) => technique.classifications.includes(group)) ?? "other";
    const baseLegality = getLegality(technique.slug);
    const variants = getVariantsFor(technique.slug);
    const hasTechniqueVideo = Boolean(getTechniqueVideo(technique.slug));
    const isAuthorEdited = false;
    const gripContextSlugSet = new Set(technique.gripContextSlugs ?? []);
    for (const variant of variants) {
      for (const slug of variant.gripContextSlugs ?? []) {
        gripContextSlugSet.add(slug);
      }
      for (const sequence of variant.directionSequences ?? []) {
        if (sequence.stanceContext && sequence.stanceContext !== "any") {
          gripContextSlugSet.add(sequence.stanceContext);
        }
      }
      for (const sequence of variant.mechanics?.directionSequences ?? []) {
        if (sequence.stanceContext && sequence.stanceContext !== "any") {
          gripContextSlugSet.add(sequence.stanceContext);
        }
      }
    }
    const gripContextSlugs = Array.from(gripContextSlugSet);
    const gripContextLabels = gripContextSlugs.map((slug) => (
      gripContexts.find((context) => context.slug === slug)
    ));
    const gripContextDisplayLabels = gripContextLabels.map((context) => (
      context ? contextDisplayLabel(context) : ""
    )).filter(Boolean);
    const variantLegalityRows = variants.map((variant) => ({
      variant,
      legality: getLegality(variant.slug)
    }));
    const subjectSlugs = new Set([technique.slug, ...variants.map((variant) => variant.slug)]);
    const startsCombo = comboEdges.some((edge) => subjectSlugs.has(edge.fromSlug));
    const followsCombo = comboEdges.some((edge) => subjectSlugs.has(edge.toSlug));
    const hasComboLinks = startsCombo || followsCombo;
    const legalityStatuses = variantLegalityRows.map((row) => row.legality?.status).filter(Boolean);
    const legalVariantCount = variantLegalityRows.filter((row) => row.legality?.status === "legal").length;
    const bannedVariantCount = variantLegalityRows.filter((row) => row.legality?.status === "illegal").length;
    const restrictedVariantCount = variantLegalityRows.filter((row) => row.legality?.status === "restricted").length;
    const hasDropEntry = variants.some((variant) => (
      variant.actionFeatures?.includes("drop-entry") ||
      variant.modifiers?.includes("drop-entry") ||
      variant.modifiers?.includes("drop")
    )) || technique.names.english.toLowerCase().includes("drop") || technique.names.aliases.some((alias) => alias.toLowerCase().includes("drop"));
    const classicBanned = variantLegalityRows.some((row) => (
      row.legality?.status === "illegal" &&
      row.variant.modifiers.some((modifier) => ["classic", "traditional"].includes(modifier))
    ));
    const baseLegal = baseLegality?.status === "legal";
    const baseIllegal = baseLegality?.status === "illegal";
    const baseRestricted = baseLegality?.status === "restricted";
    const hasCompetitionLegalRecord = baseLegal || legalVariantCount > 0;
    const hasMixedLegality = hasCompetitionLegalRecord && (bannedVariantCount > 0 || restrictedVariantCount > 0 || baseRestricted);
    const advisories = [
      ...getSafetyAdvisories(technique.slug),
      ...variants.flatMap((variant) => getSafetyAdvisories(variant.slug))
    ];
    const promotionRanksForTechnique = promotionRanks.filter((rank) => rank.techniqueSlugs.includes(technique.slug));
    const promotionRankIds = promotionRanksForTechnique.map((rank) => rank.id);
    const kataMembershipsForTechnique = kataFilters.filter((kata) => kata.techniqueSlugs.includes(technique.slug));
    const kataMembershipIds = kataMembershipsForTechnique.map((kata) => kata.id);
    const filterFlags = [
      variants.length > 0 && "has-variants",
      hasDropEntry && "drop-entry",
      hasCompetitionLegalRecord && "competition-legal",
      (bannedVariantCount > 0 || baseIllegal) && "banned-variant",
      classicBanned && "classic-banned",
      (restrictedVariantCount > 0 || baseRestricted) && "restricted-variant",
      hasMixedLegality && "mixed-legality",
      advisories.length > 0 && "safety-note",
      hasTechniqueVideo && "video-linked",
      !hasTechniqueVideo && "video-not-linked",
      isAuthorEdited && "author-edited",
      !isAuthorEdited && "pending-review",
      hasComboLinks && "has-combo-links",
      startsCombo && "combo-starter",
      followsCombo && "combo-follow-up",
      promotionRankIds.length > 0 && "promotion-requirement"
    ].filter(Boolean).join(" ");
    return {
      technique,
      primaryGroup,
      baseLegality,
      variants,
      displayAliases,
      gripContextSlugs,
      gripContextLabels: gripContextDisplayLabels,
      legalityStatuses,
      hasCompetitionLegalRecord,
      baseLegal,
      baseIllegal,
      baseRestricted,
      legalVariantCount,
      bannedVariantCount,
      restrictedVariantCount,
      hasDropEntry,
      classicBanned,
      hasMixedLegality,
      hasComboLinks,
      startsCombo,
      followsCombo,
      advisories,
      promotionRanksForTechnique,
      promotionRankIds,
      kataMembershipsForTechnique,
      kataMembershipIds,
      roles: technique.roles.join(" "),
      filterFlags,
      searchText: [
        technique.slug,
        technique.names.english,
        technique.names.japaneseRomaji,
        technique.names.japanese,
        technique.names.kana,
        ...technique.names.aliases,
        ...technique.classifications,
        ...variants.flatMap((variant) => [
          variant.name,
          ...variant.modifiers,
          ...(variant.actionFeatures ?? [])
        ]),
        ...gripContextSlugs,
        ...gripContextDisplayLabels,
        ...promotionRanksForTechnique.flatMap((rank) => [
          rank.label,
          rank.japaneseRomaji,
          rank.beltColor,
          promotionRequirementLabel
        ]),
        ...kataMembershipsForTechnique.flatMap((kata) => [
          kata.label,
          kata.english,
          kata.japanese,
          kata.kana
        ])
      ].join(" ").toLowerCase()
    };
  });
---

<BaseLayout title="Technical Machine" feedbackPageType="catalog">
  <section class="intro" aria-labelledby="page-title">
    <div>
      <p class="eyebrow">Technique catalog</p>
      <h1 id="page-title">Judo technique catalog</h1>
      <p class="sensei-credit">
        Built with gratitude for Sensei Takehito Ikezaki.
        <a href="https://marloncoloradojudo.com/schedule/#book">Book a free trial at Marlon Colorado Judo</a>.
      </p>
      <p class="lede">
        {browsableTechniques.length} techniques with Japanese names, kana, classifications, variants, legality notes, safety advisories, and combo hooks.
      </p>
    </div>
    <img class="mark" src={urlFor("/technical-machine-icon.svg")} alt="" width="150" height="150" />
  </section>

  <section class="family-tabs" aria-label="Technical families">
    <div class="family-tabs-header">
      <button class="family-tab active" type="button" data-family-tab="all">
        All techniques <span>{browsableTechniques.length}</span>
      </button>
      <button class="family-reset" type="button" id="clear-family-filter">Clear family</button>
    </div>
    <input type="hidden" id="group-filter" value="all" />
    {familyGroups.map((family) => (
      <div class="family-row">
        <h2>
          <span class="family-heading-kanji">{family.kanji}</span>
          <span>{family.title}</span>
          <small>{family.english}</small>
        </h2>
        <div class="family-tab-list">
          {family.groups.map((group) => (
            <button class="family-tab" type="button" data-family-tab={group.slug}>
              <span class="tab-kanji">{familyDisplay[group.slug]?.kanji ?? group.kanji}</span>
              <span class="tab-text">{group.label}</span>
              <small>({familyDisplay[group.slug]?.english ?? group.english})</small>
              <span>{group.count}</span>
            </button>
          ))}
        </div>
      </div>
    ))}
  </section>

  <section aria-label="Technique controls">
    <div class="toolbar">
      <div class="toolbar-primary">
        <label class="sr-only" for="technique-search">Search techniques</label>
        <input class="field" id="technique-search" type="search" placeholder="Search English, romaji, kana, kanji, alias" autocomplete="off" />
        <fieldset class="side-toggle" aria-label="Tori side">
          <legend>Tori side</legend>
          <div class="side-switch">
            <span class="side-switch-thumb" aria-hidden="true"></span>
            <button type="button" value="left" data-tori-side-toggle aria-pressed="false">
              <span>Left</span>
            </button>
            <button type="button" value="right" data-tori-side-toggle aria-pressed="true">
              <span>Right</span>
            </button>
          </div>
        </fieldset>
      </div>

      <div class="filter-presets" aria-label="Filter presets">
        <span class="filter-label">Quick filters</span>
        <div class="preset-chip-list">
          <button class="preset-chip" type="button" data-filter-preset="competition">Competition legal</button>
          <button class="preset-chip" type="button" data-filter-preset="promotion">Promotion study</button>
          <button class="preset-chip" type="button" data-filter-preset="combos">Combos</button>
          <button class="preset-chip" type="button" data-filter-preset="counters">Counters</button>
          <button class="preset-chip" type="button" data-filter-preset="groundwork">Groundwork</button>
          <button class="preset-chip" type="button" data-filter-preset="opposite-side">Opposite-side stance</button>
        </div>
      </div>

      <fieldset class="filter-groups primary-filter-groups" aria-label="Primary technique filters">
        <div class="filter-group">
          <span class="filter-label">Role</span>
          <div class="toggle-group">
            <button class="toggle" type="button" value="attack" data-role-toggle aria-pressed="false">
              <span>Attacks</span>
            </button>
            <button class="toggle" type="button" value="counter" data-role-toggle aria-pressed="false">
              <span>Counters</span>
            </button>
            <button class="toggle" type="button" value="escape" data-role-toggle aria-pressed="false">
              <span>Escapes</span>
            </button>
          </div>
        </div>
        <div class="filter-group">
          <span class="filter-label">
            Variants & Rules
            <small>IJF Senior rules, 2026</small>
          </span>
          <div class="toggle-group">
            <button class="toggle success-toggle" type="button" value="competition-legal" data-status-toggle aria-pressed="false">
              <span>IJF senior legal</span>
            </button>
            <button class="toggle warning-toggle" type="button" value="safety-note" data-status-toggle aria-pressed="false">
              <span>Safety note</span>
            </button>
            <button class="toggle danger-toggle" type="button" value="banned-variant" data-status-toggle aria-pressed="false">
              <span>Banned variant</span>
            </button>
            <button class="toggle danger-toggle" type="button" value="restricted-variant" data-status-toggle aria-pressed="false">
              <span>Restricted</span>
            </button>
          </div>
        </div>
        <button class="clear-filters" type="button" id="clear-filters">Clear all</button>
      </fieldset>

      <details class="more-filters" id="more-filters">
        <summary>More filters</summary>
        <fieldset class="filter-groups advanced-filter-groups" aria-label="Additional technique filters">
          <div class="filter-group">
            <span class="filter-label">Grip / Position</span>
            <div class="context-filter-stack">
              {contextFilterGroups.map((group) => (
                <div class="context-filter-group">
                  <span class="context-filter-label">{group.title}</span>
                  <div class="toggle-group">
                    {group.contexts.map((context) => (
                      <button class="toggle" type="button" value={context.slug} data-grip-toggle aria-pressed="false" title={context.shortGloss}>
                        <span>
                          {context.label}
                          {context.japanese && <small>{context.japanese}</small>}
                        </span>
                      </button>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
          <div class="filter-group">
            <span class="filter-label">Sequence Links</span>
            <div class="toggle-group">
              <button class="toggle" type="button" value="has-combo-links" data-status-toggle aria-pressed="false">
                <span>Has combo links</span>
              </button>
              <button class="toggle" type="button" value="combo-starter" data-status-toggle aria-pressed="false">
                <span>Combo starter</span>
              </button>
              <button class="toggle" type="button" value="combo-follow-up" data-status-toggle aria-pressed="false">
                <span>Combo follow-up</span>
              </button>
              <button class="toggle" type="button" value="transition" data-role-toggle aria-pressed="false">
                <span>Transitions</span>
              </button>
            </div>
          </div>
          <div class="filter-group">
            <span class="filter-label">Variants</span>
            <div class="toggle-group">
              <button class="toggle" type="button" value="has-variants" data-status-toggle aria-pressed="false">
                <span>Has variants</span>
              </button>
              <button class="toggle" type="button" value="drop-entry" data-status-toggle aria-pressed="false">
                <span>Drop entry</span>
              </button>
              <button class="toggle danger-toggle" type="button" value="classic-banned" data-status-toggle aria-pressed="false">
                <span>Classic banned</span>
              </button>
              <button class="toggle mixed-toggle" type="button" value="mixed-legality" data-status-toggle aria-pressed="false">
                <span>Mixed legality</span>
              </button>
            </div>
          </div>
          <div class="filter-group">
            <span class="filter-label">Content</span>
            <div class="toggle-group">
              <button class="toggle" type="button" value="video-linked" data-status-toggle aria-pressed="false">
                <span>Video linked</span>
              </button>
              <button class="toggle" type="button" value="video-not-linked" data-status-toggle aria-pressed="false">
                <span>Video not linked</span>
              </button>
              <button class="toggle" type="button" value="author-edited" data-status-toggle aria-pressed="false">
                <span>Author edited</span>
              </button>
              <button class="toggle" type="button" value="pending-review" data-status-toggle aria-pressed="false">
                <span>Pending review</span>
              </button>
            </div>
          </div>
          <div class="filter-group">
            <span class="filter-label">
              Promotion Requirements
              <small>{promotionRequirementLabel}</small>
            </span>
            <div class="toggle-group">
              <button class="toggle" type="button" value="promotion-requirement" data-status-toggle aria-pressed="false">
                <span>Any promotion requirement</span>
              </button>
              {promotionRanks.map((rank) => (
                <button class={`toggle rank-toggle rank-${rank.beltColor}`} type="button" value={rank.id} data-promotion-toggle aria-pressed="false">
                  <span>{rank.label} · {rank.beltColor}</span>
                </button>
              ))}
              {kataFilters.map((kata) => (
                <button class="toggle kata-toggle" type="button" value={kata.id} data-kata-toggle aria-pressed="false">
                  <span>{kata.label}</span>
                </button>
              ))}
            </div>
          </div>
        </fieldset>
      </details>

      <div class="active-filter-summary" id="active-filter-summary" hidden>
        <span class="filter-label">Active filters</span>
        <div class="tags" id="active-filter-tags"></div>
      </div>
    </div>
  </section>

  <section class="technique-grid" id="technique-grid" aria-label="Techniques">
    {cards.map(({
      technique,
      primaryGroup,
      baseLegality,
      variants,
      displayAliases,
      gripContextSlugs,
      gripContextLabels,
      legalityStatuses,
      hasCompetitionLegalRecord,
      baseLegal,
      baseIllegal,
      baseRestricted,
      legalVariantCount,
      bannedVariantCount,
      restrictedVariantCount,
      hasDropEntry,
      classicBanned,
      hasMixedLegality,
      hasComboLinks,
      startsCombo,
      followsCombo,
      advisories,
      promotionRanksForTechnique,
      promotionRankIds,
      kataMembershipsForTechnique,
      kataMembershipIds,
      roles,
      filterFlags,
      searchText
    }) => (
      <article
        class="technique-card"
        data-technique-card
        data-group={primaryGroup}
        data-roles={roles}
        data-grips={gripContextSlugs.join(" ")}
        data-promotions={promotionRankIds.join(" ")}
        data-katas={kataMembershipIds.join(" ")}
        data-filters={filterFlags}
        data-search={searchText}
      >
        <div class="card-top">
          <div>
            <a class="name-stack" href={urlFor(`/techniques/${technique.slug}/`)}>
              <span class="kanji-title">{technique.names.japanese}</span>
              <span class="reading-line">{technique.names.japaneseRomaji} · {technique.names.kana}</span>
            </a>
            <div class="english-name">
              {technique.names.english}
            </div>
            {displayAliases.length > 0 && (
              <div class="alias-line">
                Also: {displayAliases.join(", ")}
              </div>
            )}
          </div>
          <span class="tag accent">{primaryGroup}</span>
        </div>
        <div class="tags">
          {technique.roles.map((role) => <span class="tag">{role}</span>)}
          {gripContextLabels.map((label) => <span class="tag">{label}</span>)}
          {variants.length > 0 && <span class="tag">{variants.length} variants</span>}
          {hasDropEntry && <span class="tag">drop entry</span>}
          {baseLegal && <span class="tag success">competition legal</span>}
          {legalVariantCount > 0 && <span class="tag success">{legalVariantCount} legal variant{legalVariantCount === 1 ? "" : "s"}</span>}
          {classicBanned && <span class="tag danger">classic banned</span>}
          {!classicBanned && bannedVariantCount > 0 && <span class="tag danger">{bannedVariantCount} banned variant{bannedVariantCount === 1 ? "" : "s"}</span>}
          {baseIllegal && variants.length === 0 && <span class="tag danger">competition banned</span>}
          {restrictedVariantCount > 0 && <span class="tag danger">{restrictedVariantCount} restricted variant{restrictedVariantCount === 1 ? "" : "s"}</span>}
          {baseRestricted && variants.length === 0 && <span class="tag danger">restricted</span>}
          {hasMixedLegality && <span class="tag mixed">mixed legality</span>}
          {advisories.length > 0 && <span class="tag warning">safety note</span>}
          {hasComboLinks && <span class="tag accent">combo linked</span>}
          {startsCombo && <span class="tag">starter</span>}
          {followsCombo && <span class="tag">follow-up</span>}
          {promotionRanksForTechnique.map((rank) => (
            <span class={`tag rank-tag rank-${rank.beltColor}`}>{rank.label} · {rank.beltColor}</span>
          ))}
          {kataMembershipsForTechnique.map((kata) => (
            <span class="tag kata-tag">{kata.label}</span>
          ))}
        </div>
      </article>
    ))}
  </section>

  <script>
    const search = document.querySelector("#technique-search");
    const groupFilter = document.querySelector("#group-filter");
    const familyTabs = Array.from(document.querySelectorAll("[data-family-tab]"));
    const clearFamilyFilter = document.querySelector("#clear-family-filter");
    const roleToggles = Array.from(document.querySelectorAll("[data-role-toggle]"));
    const gripToggles = Array.from(document.querySelectorAll("[data-grip-toggle]"));
    const statusToggles = Array.from(document.querySelectorAll("[data-status-toggle]"));
    const promotionToggles = Array.from(document.querySelectorAll("[data-promotion-toggle]"));
    const kataToggles = Array.from(document.querySelectorAll("[data-kata-toggle]"));
    const clearFilters = document.querySelector("#clear-filters");
    const presetButtons = Array.from(document.querySelectorAll("[data-filter-preset]"));
    const moreFilters = document.querySelector("#more-filters");
    const activeFilterSummary = document.querySelector("#active-filter-summary");
    const activeFilterTags = document.querySelector("#active-filter-tags");
    const cards = Array.from(document.querySelectorAll("[data-technique-card]"));
    const toriSideToggles = Array.from(document.querySelectorAll("[data-tori-side-toggle]"));
    const appRoot = document.querySelector("[data-technical-machine]");
    const params = new URLSearchParams(window.location.search);
    const initialGroup = params.get("group");
    const groupAliases = {
      "nage-waza": ["te-waza", "koshi-waza", "ashi-waza", "ma-sutemi-waza", "yoko-sutemi-waza"],
      "katame-waza": ["osaekomi-waza", "shime-waza", "kansetsu-waza"]
    };
    const storedToriSide = localStorage.getItem("judo-tori-side") ?? "right";
    const paramValues = (...keys) => keys.flatMap((key) => (
      params.getAll(key).flatMap((value) => value.split(",").map((item) => item.trim()).filter(Boolean))
    ));
    const filterLabels = {
      attack: "Attacks",
      counter: "Counters",
      transition: "Transitions",
      escape: "Escapes",
      aiyotsu: "Aiyotsu",
      kenkayotsu: "Kenkayotsu",
      "standard-kumi-kata": "Standard grip",
      "georgian-grip": "Georgian grip",
      "leg-control": "Leg control",
      "side-control": "Side control",
      mount: "Mount",
      guard: "Guard",
      "north-south": "North-south",
      "collar-sleeve-control": "Collar-sleeve control",
      "frame-control": "Frame control",
      "underhook-hip-control": "Underhook / hip control",
      "over-back-belt-control": "Over-back / belt control",
      "competition-legal": "IJF senior legal",
      "safety-note": "Safety note",
      "banned-variant": "Banned variant",
      "restricted-variant": "Restricted",
      "has-combo-links": "Has combo links",
      "combo-starter": "Combo starter",
      "combo-follow-up": "Combo follow-up",
      "has-variants": "Has variants",
      "drop-entry": "Drop entry",
      "classic-banned": "Classic banned",
      "mixed-legality": "Mixed legality",
      "video-linked": "Video linked",
      "video-not-linked": "Video not linked",
      "author-edited": "Author edited",
      "pending-review": "Pending review",
      "promotion-requirement": "Any promotion requirement"
    };

    function toggleValue(toggle) {
      return toggle instanceof HTMLInputElement || toggle instanceof HTMLButtonElement ? toggle.value : "";
    }

    function isToggleActive(toggle) {
      if (toggle instanceof HTMLInputElement) return toggle.checked;
      if (toggle instanceof HTMLButtonElement) return toggle.getAttribute("aria-pressed") === "true";
      return false;
    }

    function setToggleActive(toggle, active) {
      if (toggle instanceof HTMLInputElement) {
        toggle.checked = active;
      }
      if (toggle instanceof HTMLButtonElement) {
        toggle.setAttribute("aria-pressed", active ? "true" : "false");
      }
    }

    function togglePressed(toggle) {
      setToggleActive(toggle, !isToggleActive(toggle));
    }

    function setToriSide(side) {
      const nextSide = side === "left" ? "left" : "right";
      if (appRoot instanceof HTMLElement) appRoot.dataset.toriSide = nextSide;
      localStorage.setItem("judo-tori-side", nextSide);
      for (const toggle of toriSideToggles) {
        setToggleActive(toggle, toggleValue(toggle) === nextSide);
      }
    }

    function clearAllFilterInputs() {
      if (search instanceof HTMLInputElement) search.value = "";
      if (groupFilter instanceof HTMLInputElement) groupFilter.value = "all";

      for (const toggle of [...roleToggles, ...gripToggles, ...statusToggles, ...promotionToggles, ...kataToggles]) {
        setToggleActive(toggle, false);
      }
    }

    function setChecked(toggles, value, checked = true) {
      for (const toggle of toggles) {
        if (toggleValue(toggle) === value) setToggleActive(toggle, checked);
      }
    }

    function labelForToggle(toggle) {
      const value = toggleValue(toggle);
      if (!value) return "";
      return filterLabels[value] ?? toggle.textContent?.trim() ?? value;
    }

    function updateActiveFilterSummary({
      selectedRoles,
      selectedGrips,
      selectedStatuses,
      selectedPromotions,
      selectedKatas,
      group,
      term
    }) {
      if (!(activeFilterSummary instanceof HTMLElement) || !(activeFilterTags instanceof HTMLElement)) return;

      const labels = [];
      if (term) labels.push(`Search: ${term}`);
      if (group !== "all") labels.push(groupAliases[group] ? group : group);

      for (const value of selectedRoles) labels.push(filterLabels[value] ?? value);
      for (const value of selectedGrips) labels.push(filterLabels[value] ?? value);
      for (const value of selectedStatuses) labels.push(filterLabels[value] ?? value);
      for (const value of selectedPromotions) {
        const toggle = promotionToggles.find((item) => toggleValue(item) === value);
        labels.push(labelForToggle(toggle));
      }
      for (const value of selectedKatas) {
        const toggle = kataToggles.find((item) => toggleValue(item) === value);
        labels.push(labelForToggle(toggle));
      }

      activeFilterTags.replaceChildren(...labels.map((label) => {
        const tag = document.createElement("span");
        tag.className = "tag";
        tag.textContent = label;
        return tag;
      }));
      activeFilterSummary.hidden = labels.length === 0;
    }

    function applyPreset(preset) {
      clearAllFilterInputs();

      if (preset === "competition") {
        setChecked(statusToggles, "competition-legal");
      }
      if (preset === "promotion") {
        setChecked(statusToggles, "promotion-requirement");
        if (moreFilters instanceof HTMLDetailsElement) moreFilters.open = true;
      }
      if (preset === "combos") {
        if (groupFilter instanceof HTMLInputElement) groupFilter.value = "nage-waza";
        setChecked(roleToggles, "attack");
        setChecked(statusToggles, "has-combo-links");
        if (moreFilters instanceof HTMLDetailsElement) moreFilters.open = true;
      }
      if (preset === "counters") {
        setChecked(roleToggles, "counter");
      }
      if (preset === "groundwork") {
        if (groupFilter instanceof HTMLInputElement) groupFilter.value = "katame-waza";
        if (moreFilters instanceof HTMLDetailsElement) moreFilters.open = true;
      }
      if (preset === "opposite-side") {
        if (groupFilter instanceof HTMLInputElement) groupFilter.value = "nage-waza";
        setChecked(roleToggles, "attack");
        setChecked(gripToggles, "kenkayotsu");
        if (moreFilters instanceof HTMLDetailsElement) moreFilters.open = true;
      }

      applyFilters();
    }

    if (initialGroup && groupFilter instanceof HTMLInputElement) {
      groupFilter.value = initialGroup;
    }
    if (search instanceof HTMLInputElement) {
      search.value = params.get("q") ?? params.get("search") ?? "";
    }
    for (const toggle of roleToggles) {
      setToggleActive(toggle, paramValues("role", "roles").includes(toggleValue(toggle)));
    }
    for (const toggle of gripToggles) {
      setToggleActive(toggle, paramValues("grip", "grips", "context", "contexts").includes(toggleValue(toggle)));
    }
    for (const toggle of statusToggles) {
      setToggleActive(toggle, paramValues("status", "statuses", "filter", "filters").includes(toggleValue(toggle)));
    }
    for (const toggle of promotionToggles) {
      setToggleActive(toggle, paramValues("promotion", "promotions").includes(toggleValue(toggle)));
    }
    for (const toggle of kataToggles) {
      setToggleActive(toggle, paramValues("kata", "katas").includes(toggleValue(toggle)));
    }
    const advancedStatusValues = new Set([
      "has-combo-links",
      "combo-starter",
      "combo-follow-up",
      "has-variants",
      "drop-entry",
      "classic-banned",
      "mixed-legality",
      "video-linked",
      "video-not-linked",
      "author-edited",
      "pending-review",
      "promotion-requirement"
    ]);
    if (
      moreFilters instanceof HTMLDetailsElement &&
      (
        [...gripToggles, ...promotionToggles, ...kataToggles].some(isToggleActive) ||
        statusToggles.some((toggle) => isToggleActive(toggle) && advancedStatusValues.has(toggleValue(toggle))) ||
        roleToggles.some((toggle) => isToggleActive(toggle) && toggleValue(toggle) === "transition")
      )
    ) {
      moreFilters.open = true;
    }
    setToriSide(storedToriSide);

    function syncFamilyTabs() {
      const group = groupFilter instanceof HTMLInputElement ? groupFilter.value : "all";
      for (const tab of familyTabs) {
        tab.classList.toggle("active", tab instanceof HTMLElement && tab.dataset.familyTab === group);
      }
    }

    function matchesGroupFilter(cardGroup, selectedGroup) {
      if (selectedGroup === "all") return true;
      if (cardGroup === selectedGroup) return true;
      return groupAliases[selectedGroup]?.includes(cardGroup) ?? false;
    }

    function applyFilters() {
      const term = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : "";
      const group = groupFilter instanceof HTMLInputElement ? groupFilter.value : "all";
      const selectedRoles = roleToggles
        .filter(isToggleActive)
        .map(toggleValue);
      const selectedGrips = gripToggles
        .filter(isToggleActive)
        .map(toggleValue);
      const selectedStatuses = statusToggles
        .filter(isToggleActive)
        .map(toggleValue);
      const selectedPromotions = promotionToggles
        .filter(isToggleActive)
        .map(toggleValue);
      const selectedKatas = kataToggles
        .filter(isToggleActive)
        .map(toggleValue);

      for (const card of cards) {
        const matchesText = !term || card.dataset.search?.includes(term);
        const matchesGroup = matchesGroupFilter(card.dataset.group ?? "", group);
        const cardRoles = card.dataset.roles?.split(" ") ?? [];
        const cardGrips = card.dataset.grips?.split(" ").filter(Boolean) ?? [];
        const cardFilters = card.dataset.filters?.split(" ").filter(Boolean) ?? [];
        const cardPromotions = card.dataset.promotions?.split(" ").filter(Boolean) ?? [];
        const cardKatas = card.dataset.katas?.split(" ").filter(Boolean) ?? [];
        const matchesRoles = selectedRoles.every((role) => cardRoles.includes(role));
        const matchesGrips = selectedGrips.every((grip) => cardGrips.includes(grip));
        const matchesStatuses = selectedStatuses.every((status) => cardFilters.includes(status));
        const matchesPromotions = selectedPromotions.every((promotion) => cardPromotions.includes(promotion));
        const matchesKatas = selectedKatas.every((kata) => cardKatas.includes(kata));
        card.hidden = !(matchesText && matchesGroup && matchesRoles && matchesGrips && matchesStatuses && matchesPromotions && matchesKatas);
      }
      updateActiveFilterSummary({
        selectedRoles,
        selectedGrips,
        selectedStatuses,
        selectedPromotions,
        selectedKatas,
        group,
        term
      });
      syncFamilyTabs();
    }

    search?.addEventListener("input", applyFilters);
    for (const tab of familyTabs) {
      tab.addEventListener("click", () => {
        if (groupFilter instanceof HTMLInputElement && tab instanceof HTMLElement) {
          groupFilter.value = tab.dataset.familyTab ?? "all";
        }
        applyFilters();
      });
    }
    clearFamilyFilter?.addEventListener("click", () => {
      if (groupFilter instanceof HTMLInputElement) groupFilter.value = "all";
      applyFilters();
    });
    for (const toggle of roleToggles) {
      toggle.addEventListener("click", () => {
        togglePressed(toggle);
        applyFilters();
      });
    }
    for (const toggle of gripToggles) {
      toggle.addEventListener("click", () => {
        togglePressed(toggle);
        applyFilters();
      });
    }
    for (const toggle of statusToggles) {
      toggle.addEventListener("click", () => {
        togglePressed(toggle);
        applyFilters();
      });
    }
    for (const toggle of promotionToggles) {
      toggle.addEventListener("click", () => {
        togglePressed(toggle);
        applyFilters();
      });
    }
    for (const toggle of kataToggles) {
      toggle.addEventListener("click", () => {
        togglePressed(toggle);
        applyFilters();
      });
    }
    for (const toggle of toriSideToggles) {
      toggle.addEventListener("click", () => {
        setToriSide(toggleValue(toggle));
      });
    }
    for (const button of presetButtons) {
      button.addEventListener("click", () => {
        if (button instanceof HTMLElement) applyPreset(button.dataset.filterPreset ?? "");
      });
    }
    clearFilters?.addEventListener("click", () => {
      clearAllFilterInputs();
      applyFilters();
    });
    applyFilters();
  </script>
</BaseLayout>
